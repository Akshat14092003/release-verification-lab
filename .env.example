# Node reads this file only when explicitly passed --env-file=.env.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/lab.sqlite

# Optional server-side clock override for repeatable local demonstrations.
# Saturday: 2026-10-24T12:00:00.000Z; Monday: 2026-10-26T12:00:00.000Z
# LAB_NOW=2026-10-24T12:00:00.000Z

# Intentionally unsafe local demonstrations; all OFF by default.
BUG_AUTH_BYPASS=0
BUG_WEEKEND_OFFER=0
BUG_NO_LIMIT=0
BUG_TOTAL_MISMATCH=0
