# Node reads this file only when explicitly passed --env-file=.env.
HOST=127.0.0.1
PORT=3000
# Set only when deployed behind one trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Browser-test concurrency: 2 normally; 1 for a small hosting instance. Test coverage is unchanged.
LAB_TEST_WORKERS=2
# Loopback startup shares one persistent shop across browsers by default.
# Set 0 for independent visitor sandboxes. Non-loopback hosts default to isolated shops.
# LAB_SHARED_SHOP=1
DATABASE_PATH=.data/lab.sqlite

# Optional server-side clock override for repeatable local demonstrations.
# Saturday: 2026-10-24T12:00:00.000Z; Monday: 2026-10-26T12:00:00.000Z
# LAB_NOW=2026-10-24T12:00:00.000Z

# Intentionally unsafe local demonstrations; all OFF by default.
BUG_AUTH_BYPASS=0
BUG_WEEKEND_OFFER=0
BUG_NO_LIMIT=0
BUG_TOTAL_MISMATCH=0
